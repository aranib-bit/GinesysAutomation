### Custom: Reports and Logs ###
# Ignore all HTML report files
*.html
**/*.html

# Ignore reports folder and all contents
/reports/
reports/**/*

# Ignore logs folder and all contents
logs/
/logs/
logs/**/*

# Ignore OLD LOGS AND REPORTS folder (with spaces in name)
OLD\ LOGS\ AND\ REPORTS/
/OLD\ LOGS\ AND\ REPORTS/
**/OLD\ LOGS\ AND\ REPORTS/
OLD\ LOGS\ AND\ REPORTS/**/*

# Also ignore the specific JSON report I saw in your example
/reports/js-errors/
*.json
### Environment selection / secrets (see EnvResolver, Secrets) ###
/env.local
src/test/resources/env/*/secrets.local.properties

### Local tooling / generated (not for sharing) ###
.idea/dataSources/
.idea/dataSources.*
.codex/
*.log
graphify-out/converted/
graphify-out/cache/
graphify-out/.graphify_labels.json.sig
test-output/

