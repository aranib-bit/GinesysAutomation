<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
    AP Voucher MANDATORY Suite — validation rules + the MANDATORY-tagged CreateApVoucher rows
    only (apv.group=MANDATORY, ~7 scenarios per ApVoucherExecutionGroup's javadoc), standalone
    from AR Voucher / Account Group. DB-mode only (testdata.source=DB) — ExcelApVoucherDataSource
    has no group filtering.

    SessionPool execution model (see testng-ap-smoke.xml for full detail): the 3 CreateApVoucher
    @Test methods run in parallel and each method's rows also run in parallel
    (runInParallel=true on MergedFinApVoucherDataSupplier); every row borrows a pooled logged-in
    session (com.gsl.driver.SessionPool) and returns it after, so rows interleave across
    (capacity = UI-user count - backfill headroom) sessions with "Already Loaded" cache hits from
    the 2nd borrow on. thread-count=2 here is deliberately below the 3-method count — the
    ap-mandatory Maven profile raises datafallback.userPool.backfillHeadroom (via a
    system-property override, ApiConfig.java) to cap SessionPool at 2 concurrent browsers, since
    this suite's single-node Selenium Grid container has no memory limit and was seeing 4-5
    concurrent Chrome instances contend for RAM. Extra demand beyond 2 just queues.

    Run: mvn clean test -Pap-mandatory
-->
<suite name="AP Voucher — Mandatory Suite" parallel="none" data-provider-thread-count="4">

    <listeners>
        <listener class-name="com.gsl.listeners.RetryAnnotationTransformer"/>
        <listener class-name="com.gsl.listeners.TestListener"/>
        <listener class-name="com.gsl.listeners.SuiteDataLoader"/>
        <listener class-name="com.gsl.listeners.AnnotationMethodInterceptor"/>
    </listeners>

    <test name="AP Voucher Validation — Mandatory">
        <parameter name="voucherDomain" value="AP"/>
        <parameter name="executionType" value="MANDATORY"/>
        <classes>
            <class name="com.tests.Validation.RuleTest"/>
        </classes>
    </test>

    <test name="AP Voucher Create — Mandatory" parallel="methods" thread-count="2">
        <parameter name="apv.group" value="MANDATORY"/>
        <classes>
            <class name="com.tests.Finance.Operations.Vouchers.CreateApVoucher"/>
        </classes>
    </test>

</suite>
