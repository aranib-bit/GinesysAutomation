<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
    Regression Phase-2 — AP Voucher extended regression scenarios.
    May include party-type matrix, additional payment scenarios, and complex validations.

    Run: mvn clean test -Pregression-apvoucher-phase2
-->
<!-- data-provider-thread-count MUST be at suite level — TestNG ignores it on <test>. -->
<suite name="AP Voucher — Regression Phase-2" configfailurepolicy="continue" parallel="none" data-provider-thread-count="4">
    <listeners>
        <listener class-name="com.gsl.listeners.RetryAnnotationTransformer"/>
        <listener class-name="com.gsl.listeners.TestListener"/>
        <listener class-name="com.gsl.listeners.SuiteDataLoader"/>
        <listener class-name="com.gsl.listeners.AnnotationMethodInterceptor"/>
    </listeners>

    <test name="AP Voucher Create — Regression Phase-2"
          parallel="methods" thread-count="4">
        <!--
          apv.group=REGRESSION_PHASE2 — Phase-2 regression scenarios for AP Voucher.
          Extended regression covering party-type matrix and additional validation scenarios.
          With the suite-level DP pool of 4, up to 4 data rows run concurrently.
          The 3 test methods (advance, document, negative/boundary) can overlap within this pool.
        -->
        <parameter name="apv.group" value="REGRESSION_PHASE2"/>
        <classes>
            <class name="com.tests.Finance.Operations.Vouchers.CreateApVoucher"/>
        </classes>
    </test>

</suite>
