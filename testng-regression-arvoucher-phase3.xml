<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
    AR Voucher — Regression Phase-3 (AR only): specific document-type filter, INV-only (REG-09).
    AR-only split of testng-regression-phase3.xml; arv.group=REGRESSION_PHASE3 is set via Maven Surefire.

    Run: mvn clean test -Par-regression-phase3
-->
<!-- data-provider-thread-count MUST be at suite level — TestNG ignores it on <test>. -->
<suite name="AR Voucher — Regression Phase-3" configfailurepolicy="continue" parallel="tests" thread-count="1" data-provider-thread-count="4">
    <listeners>
        <listener class-name="com.gsl.listeners.RetryAnnotationTransformer"/>
        <listener class-name="com.gsl.listeners.TestListener"/>
        <listener class-name="com.gsl.listeners.SuiteDataLoader"/>
        <listener class-name="com.gsl.listeners.AnnotationMethodInterceptor"/>
    </listeners>

    <test name="AR Voucher Create — Regression Phase-3"
          parallel="methods" thread-count="4">
        <parameter name="arv.group" value="REGRESSION_PHASE3"/>
        <classes>
            <class name="com.tests.Finance.Operations.Vouchers.CreateArVoucher"/>
        </classes>
    </test>
</suite>
