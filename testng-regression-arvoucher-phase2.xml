<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
    AR Voucher — Regression Phase-2 (AR only): full party-type matrix, SL ownership/tagging, grid LESS/GREATER, payment MIX, backdate, Cash GL multi-doc/multi-SL, amount MIX (REG-13 to REG-19).
    AR-only split of testng-regression-phase2.xml; arv.group=REGRESSION_PHASE2 is set via Maven Surefire.

    Run: mvn clean test -Par-regression-phase2
-->
<!-- data-provider-thread-count MUST be at suite level — TestNG ignores it on <test>. -->
<suite name="AR Voucher — Regression Phase-2" parallel="tests" thread-count="1" data-provider-thread-count="8">
    <listeners>
        <listener class-name="com.gsl.listeners.RetryAnnotationTransformer"/>
        <listener class-name="com.gsl.listeners.TestListener"/>
        <listener class-name="com.gsl.listeners.SuiteDataLoader"/>
        <listener class-name="com.gsl.listeners.AnnotationMethodInterceptor"/>
    </listeners>

    <test name="AR Voucher Create — Regression Phase-2"
          parallel="methods" thread-count="8">
        <parameter name="arv.group" value="REGRESSION_PHASE2"/>
        <classes>
            <class name="com.tests.Finance.Operations.Vouchers.CreateArVoucher"/>
        </classes>
    </test>
</suite>
