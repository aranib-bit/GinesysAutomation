<!DOCTYPE aspectj PUBLIC "-//AspectJ//DTD//EN" "https://www.eclipse.org/aspectj/dtd/aspectj.dtd">
<aspectj>
    <weaver options="-Xlint:ignore">
        <include within="com.gsl..*"/>
        <include within="com.tests..*"/>
        <!-- Mirror the pointcut exclusions in LoggingAspect exactly -->
        <exclude within="com.gsl.reports..*"/>
        <exclude within="com.gsl.testdata..*"/>
        <exclude within="com.gsl.utils.Selenium.ScreenshotUtils"/>
        <exclude within="com.gsl.listeners..*"/>
    </weaver>
    <aspects>
        <aspect name="com.gsl.aspects.LoggingAspect"/>
        <aspect name="com.gsl.aspects.AuditLoggingAspect"/>
        <aspect name="io.github.sskorol.core.DataSupplierAspect"/>
    </aspects>
</aspectj>
