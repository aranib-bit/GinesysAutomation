<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30" shutdownHook="enable">

    <Properties>
        <Property name="LOG_DIR">logs</Property>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%-15t] %-5level [exec=%X{executionId}][test=%X{testName}][tcId=%X{testCaseId}][id=%X{testId}][user=%X{uiUser}][browser=%X{browser}][env=%X{env}] %logger{36} - %msg%n</Property>
        <!-- Phase 1: audience-segmented log patterns -->
        <!-- business.log — plain English, readable by QA Manager without tooling -->
        <Property name="BUSINESS_LOG_PATTERN">%d{HH:mm:ss} | [%X{testCaseId}] %msg%n</Property>
        <!-- ui-actions, db-validation, diagnostics — retain timestamp + testCaseId for cross-reference -->
        <Property name="AUDIENCE_LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{testCaseId}][%X{testName}] %-5level - %msg%n</Property>
    </Properties>

    <Appenders>

        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="RollingFileAppender"
                     fileName="${LOG_DIR}/framework.log"
                     filePattern="${LOG_DIR}/framework-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="framework-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- Async wrapper. blocking="true": under sustained load (a real suite run easily produces
             thousands of events), a non-blocking async appender SILENTLY DISCARDS events once its
             buffer fills rather than pausing the caller — confirmed the direct cause of
             framework.log containing almost nothing from an actual ~15-minute run. blocking="true"
             trades a small amount of throughput for never losing an event; bufferSize raised
             8x (512→4096) as additional headroom before that trade-off is ever exercised. -->
        <Async name="AsyncRollingFile" bufferSize="4096" blocking="true">
            <AppenderRef ref="RollingFileAppender"/>
        </Async>

        <!-- Dedicated rolling appender for indented method-flow traces (AOP) -->
        <RollingFile name="TraceFileAppender"
                     fileName="${LOG_DIR}/trace.log"
                     filePattern="${LOG_DIR}/trace-%d{yyyy-MM-dd}-%i.log.gz">
            <!-- Timestamps are embedded in the message itself — no prefix needed -->
            <PatternLayout pattern="%msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="20 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10">
                <Delete basePath="${LOG_DIR}" maxDepth="1">
                    <IfFileName glob="trace-*.log.gz"/>
                    <IfLastModified age="7d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- Non-blocking async wrapper for trace writes -->
        <Async name="AsyncTraceFile" bufferSize="1024" blocking="true">
            <AppenderRef ref="TraceFileAppender"/>
        </Async>

        <!-- ── Phase 1: Audience-segmented log files ──────────────────────────
             Each file receives only the log category(s) assigned to its audience.
             Category routing is driven by the MDC key "logCategory" set in ReportLogger.
             Uncategorized calls (no logCategory in MDC) are ignored by these appenders.
        -->

        <!-- QA Manager / Business Reviewer — plain English business flow steps -->
        <RollingFile name="BusinessFileAppender"
                     fileName="${LOG_DIR}/business.log"
                     filePattern="${LOG_DIR}/business-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${BUSINESS_LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="5 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- QA Engineer — Selenium interactions + assertion results -->
        <RollingFile name="UIActionsFileAppender"
                     fileName="${LOG_DIR}/ui-actions.log"
                     filePattern="${LOG_DIR}/ui-actions-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${AUDIENCE_LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Automation Engineer — SQL queries, DB validation results -->
        <RollingFile name="DBValidationFileAppender"
                     fileName="${LOG_DIR}/db-validation.log"
                     filePattern="${LOG_DIR}/db-validation-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${AUDIENCE_LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Automation Engineer / Dev — JS errors, perf metrics, RCA hints, framework internals -->
        <RollingFile name="DiagnosticsFileAppender"
                     fileName="${LOG_DIR}/diagnostics.log"
                     filePattern="${LOG_DIR}/diagnostics-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${AUDIENCE_LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <!--
            "Framework" is the logger name used by Log.java (LoggerFactory.getLogger("Framework")).
            Writes the full unified timeline to framework.log/console.
        -->
        <Logger name="Framework" level="DEBUG" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="AsyncRollingFile"/>
        </Logger>

        <!--
            Phase 2: direct, named loggers per audience — replaces the earlier MDC-key +
            RoutingAppender design (ReportLogger set MDC "logCategory" and a <Routing> appender
            keyed off "${ctx:logCategory}" was supposed to dispatch to the right file). That design
            left business.log/ui-actions.log/db-validation.log/diagnostics.log completely empty in
            practice — every piece looked individually correct (logger name, MDC calls, the
            log4j-slf4j2-impl bridge) but the events never arrived, most likely an MDC/ThreadContext
            propagation issue across the async boundary. Direct named loggers below remove that
            entire class of risk: ReportLogger now calls these loggers explicitly per LogCategory,
            with no context-lookup indirection involved at all.
        -->
        <!-- No ConsoleAppender here by design — "Framework" (above) already prints the unified
             console timeline for every categorized call via Log.info/warn/error; these loggers
             exist purely to give each audience file its own reliable, direct write path. -->
        <Logger name="Business" level="DEBUG" additivity="false">
            <AppenderRef ref="BusinessFileAppender"/>
        </Logger>
        <Logger name="UIActions" level="DEBUG" additivity="false">
            <AppenderRef ref="UIActionsFileAppender"/>
        </Logger>
        <Logger name="DBValidation" level="DEBUG" additivity="false">
            <AppenderRef ref="DBValidationFileAppender"/>
        </Logger>
        <Logger name="Diagnostics" level="DEBUG" additivity="false">
            <AppenderRef ref="DiagnosticsFileAppender"/>
        </Logger>

        <!-- Framework packages at DEBUG so all internal detail is captured -->
        <Logger name="com.gsl" level="DEBUG" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="AsyncRollingFile"/>
        </Logger>
        <Logger name="com.tests" level="DEBUG" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="AsyncRollingFile"/>
        </Logger>

        <!--
            AOP method-flow traces → framework.log (for flow analysis) AND trace.log (pure skeleton).
            additivity=false: prevents double-write via root logger.
            Having both means:
              - framework.log = complete picture (method trace + business logs interleaved)
              - trace.log     = pure indented call tree with no noise, for quick skeleton review
        -->
        <Logger name="MethodTrace" level="DEBUG" additivity="false">
            <AppenderRef ref="AsyncRollingFile"/>   <!-- framework.log: full flow analysis -->
            <AppenderRef ref="AsyncTraceFile"/>     <!-- trace.log: pure skeleton view -->
        </Logger>

        <!--
            System.out.println redirect (via log4j-iostreams + IoBuilder in TestListener).
            Captured into framework.log at DEBUG level; no manual file changes needed.
            additivity=false: avoids double-logging to root.
        -->
        <Logger name="SystemOut" level="DEBUG" additivity="false">
            <AppenderRef ref="AsyncRollingFile"/>
        </Logger>

        <!--
            TEMPORARY diagnostic override — root's INFO level normally suppresses HikariCP's own
            connection-lifecycle logging entirely, which is exactly why the "total=0, active=0,
            idle=0" pool-exhaustion failure on FIN-GV-EDIT-DETAIL-01 (reports/runs/20260913_141449)
            has no evidence to confirm whether it was a mass maxLifetime eviction, a DB
            connectivity blip, or something else — the report's own root-cause box says
            UNKNOWN/LOW confidence. Leave this enabled until the next such occurrence is captured
            and its cause is confirmed via these DEBUG lines (connection created/evicted/
            retired-by-maxLifetime), then remove — this is a one-time diagnostic capture, not a
            permanent verbosity change.
        -->
        <Logger name="com.zaxxer.hikari" level="DEBUG" additivity="false">
            <AppenderRef ref="AsyncRollingFile"/>
        </Logger>

        <!-- Root at INFO to suppress third-party noise (Selenium, HikariCP, etc.) -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="AsyncRollingFile"/>
        </Root>
    </Loggers>

</Configuration>
