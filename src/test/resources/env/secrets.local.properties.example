# Copy to src/test/resources/env/<env>/secrets.local.properties (gitignored) and fill in.
# Each key can alternatively be passed with -D<key>=... or as an env var named after the key,
# upper-cased with '.' -> '_' (databasepassword -> DATABASEPASSWORD, user.default.password -> USER_DEFAULT_PASSWORD).
apppassword=
databasepassword=
publicapi.clientSecret=
remote.app.server.winrm.password=
remote.app.server.ssh.password=
remote.db.server.winrm.password=
remote.db.server.ssh.password=
# UsersList.xlsx: blank password cells fall back to this; a per-user key overrides the cell.
user.default.password=
# user.webapi3.password=
