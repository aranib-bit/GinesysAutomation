<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
    Regression Phase-3 — specific document-type filter (INV-only).
    Corresponds to REG-09. arv.group=REGRESSION_PHASE3 set via Maven Surefire.

    PREREQUISITE: ArVoucherTemplateLoader pending-document query must apply
    AND entype = 'INV' when ArVoucherFixtureOptions.docTypeFilter is non-null.
    This DB query extension is the only Phase-3-specific implementation requirement.

    Run: mvn clean test -Pregression-phase3
-->
<suite name="AR Voucher — Regression Phase-3" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="com.gsl.listeners.RetryAnnotationTransformer"/>
        <listener class-name="com.gsl.listeners.TestListener"/>
        <listener class-name="com.gsl.listeners.SuiteDataLoader"/>
    </listeners>

    <test name="AR Voucher Create — Regression Phase-3"
          parallel="methods" thread-count="4" data-provider-thread-count="4">
        <parameter name="arv.group" value="REGRESSION_PHASE3"/>
        <classes>
            <class name="com.tests.Finance.Operations.Vouchers.CreateArVoucher"/>
        </classes>
    </test>
</suite>
