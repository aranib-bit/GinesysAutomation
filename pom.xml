                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Account Class — single-row ad hoc verification (see testng-accountclass-single.xml
             header). Runs only accountClassScenario against a dedicated 1-row Excel file so
             exactly one Account Class gets created, instead of the 14 rows in the full
             AccountClassLifecycle.xlsx used by the standalone accountclasslifecycle run. -->
        <profile>
            <id>accountclass-single</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <testFailureIgnore>true</testFailureIgnore>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng-accountclass-single.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <argLine>${test.jvm.args} --add-opens java.base/java.lang=ALL-UNNAMED -Drunmode=${runmode} -Dheadless=${headless} -Dbrowser=${browser}</argLine>
                            <systemPropertyVariables>
                                <finAccountClassLifecyclePath>Finance/Setup/AccountClassLifecycle_Single.xlsx</finAccountClassLifecyclePath>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- AR Voucher — Full Regression (all phases, no group filter) -->
        <profile>
            <id>regression</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <testFailureIgnore>true</testFailureIgnore>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng-regression.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <argLine>${test.jvm.args} --add-opens java.base/java.lang=ALL-UNNAMED -Drunmode=${runmode} -Dheadless=${headless} -Dbrowser=${browser}</argLine>
                            <!-- No arv.group property — DbArVoucherDataSource runs all groups -->
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>