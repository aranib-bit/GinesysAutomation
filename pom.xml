        <!-- AP Voucher — full testng-apvoucher.xml suite (Create + Revert/Delete/Edit) -->
        <profile>
            <id>apvoucher</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <testFailureIgnore>true</testFailureIgnore>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng-apvoucher.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <argLine>${test.jvm.args} --add-opens java.base/java.lang=ALL-UNNAMED -Drunmode=${runmode} -Dheadless=${headless} -Dbrowser=${browser} -Denv=${env}</argLine>
                            <systemPropertyVariables>
                                <!-- This environment has exactly 4 SET1 UI users (see testng-apvoucher.xml's
                                     own comment) and thread-count="4" uses all of them — zero spare. The new
                                     Revert/Delete/Edit tests' DocumentAdjustmentFlow/EditApVoucher self-acquire
                                     a SEPARATE UI-pool credential (ApiSessionFactory.withWebApiSession) for
                                     their untag/unpost-via-API calls, on nearly every row — a materially denser
                                     usage than the old, sparse Create-side backfill the default headroom (1)
                                     was sized for. Confirmed live (run 20260928_095807): default headroom
                                     produced a genuine "[UserPool] ... holder silent for 600s (a holder is
                                     likely stuck/hung)" timeout, editApVoucherHeader running 10-19 minutes
                                     instead of ~150s. SessionPool.capacity() = totalUiUsers - backfillHeadroom,
                                     so raising this throttles concurrent browsers to 2, guaranteeing (headroom
                                     >= concurrency, 2>=2) both can self-acquire without contention — same
                                     established technique the ap-mandatory profile below already uses for its
                                     own reason. -->
                                <datafallback.userPool.backfillHeadroom>2</datafallback.userPool.backfillHeadroom>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

