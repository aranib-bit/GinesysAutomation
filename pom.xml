                            <systemPropertyVariables>
                                <arv.group>REGRESSION_PHASE2</arv.group>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- AR Voucher — Regression Phase-3 (REG-09, INV-only doc type filter) -->
        <profile>
            <id>regression-phase3</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <testFailureIgnore>true</testFailureIgnore>
                            <suiteXmlFiles>
                                <suiteXmlFile>testng-regression-phase3.xml</suiteXmlFile>
                            </suiteXmlFiles>
                            <argLine>${test.jvm.args} --add-opens java.base/java.lang=ALL-UNNAMED -Drunmode=${runmode} -Dheadless=${headless} -Dbrowser=${browser}</argLine>
