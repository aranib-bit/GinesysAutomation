    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Local-safe defaults for CI overrides — pass -Drunmode=docker_grid -Dheadless=true on
            the command line to run against a Grid instead of a local browser. These are forwarded
            into the forked Surefire JVM via argLine below, and picked up by BrowserConfig's
            "system:properties" Owner source.
        -->
        <runmode>local</runmode>
        <headless>false</headless>
        <browser>chrome</browser>
        <!--
            Target environment folder under src/test/resources/env/ (staging, clone-staging, feature-05, ...).
            Left empty on purpose so EnvResolver falls through to the env variable / env.local / default;
            pass -Denv=feature-05 to pick one for a run.
        -->
        <env></env>
        <aspectj.version>1.9.21</aspectj.version>
        <!--
            Host-adaptive surefire JVM args. MaxRAMPercentage scales heap to the machine
            (50% of host/container RAM) instead of a fixed -Xmx, so the same pom runs on
            laptops and Jenkins agents of widely different sizes.
            Override per-run with -Dtest.jvm.args="-Xmx512m …" for tight environments.
        -->
        <!--
            -Dfile.encoding=UTF-8: JDK 17 (< JEP 400's JDK 18 default) inherits the OS's default
            charset for any implicit-charset I/O — Windows-1252 on this Windows grid, not UTF-8.
            ExtentSparkReporter's config().setEncoding("UTF-8") only controls the <meta charset>
            text it writes into the HTML; the actual file bytes are still written using this JVM
            default, so — and → came out as single Cp1252 bytes (e.g. 0x97) instead of proper
            UTF-8 sequences, which a UTF-8-declaring browser then renders as U+FFFD ("�"). Forcing
            file.encoding here makes the JVM's default charset match what the report declares.
        -->
        <!--
            The -javaagent path points straight at the dependency jar already resolved into the
            local Maven repo (org.aspectj:aspectjweaver is a normal compile-scope dependency below,
            so it's downloaded on any build regardless of phase). This used to point at
            target/aspectjweaver.jar, populated by a maven-dependency-plugin copy bound to
            process-test-resources — but IntelliJ's native TestNG runner (RemoteTestNGStarter)
            only mirrors this argLine into its own launch, it never runs Maven's lifecycle, so that
            copy never fired and target/aspectjweaver.jar didn't exist ("JAR manifest missing").
            Resolving straight into ~/.m2 works identically for `mvn test` and IntelliJ's runner,
            and survives `mvn clean` since it's outside target/.
        -->
        <!--
            -Djdk.net.unixdomain.tmpdir: on Windows, JDK 17.0.x's NIO Selector wakeup pipe is an
            AF_UNIX socket whose socket file defaults to %TEMP%. Where security software breaks
            AF_UNIX files in the user Temp folder, every java.net.http.HttpClient (Selenium's only
            HTTP backend) fails with "Unable to establish loopback connection" before any browser
            starts. Keeping the socket files inside this project's own target/ avoids that; if the
            dir is missing or the path exceeds AF_UNIX's 108-char limit, the JDK falls back to TCP
            loopback. Unused on Linux/Docker.
        -->
        <test.jvm.args>-Djdk.net.unixdomain.tmpdir=${project.build.directory} -Dfile.encoding=UTF-8 -javaagent:${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar -XX:MaxRAMPercentage=60.0 -XX:MinRAMPercentage=30.0 -XX:InitialRAMPercentage=25.0 -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError "-XX:HeapDumpPath=${project.build.directory}/heapdumps" "-Xlog:gc*:file=${project.build.directory}/gc.log:time,uptime,level,tags:filecount=5,filesize=10M"</test.jvm.args>
